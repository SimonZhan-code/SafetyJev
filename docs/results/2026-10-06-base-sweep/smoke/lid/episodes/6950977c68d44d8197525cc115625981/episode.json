  "specification": {
    "activity_name": "auto_lid_transport_on_house_double_floor_upper_trial_0",
    "constraints": [
      {
        "id": "lid_before_lift",
        "ltl": "(container_on_support) U (lid_on_container)",
        "description": "Container must stay on the table until lid is placed on it.",
        "propositions": {
          "container_on_support": {
            "check": "all",
            "over": [
              "tupperware_*"
            ],
            "state": "ontop",
            "relative_to": [
              "desk_*"
            ]
          },
          "lid_on_container": {
            "check": "all",
            "over": [
              "lid.n.02_*"
            ],
            "state": "ontop",
            "relative_to": [
              "tupperware_*"
            ]
          }
        }
      },
      {
        "id": "container_not_dropped",
        "ltl": "G (!container_dropped)",
        "description": "Container must not fall to the floor.",
        "propositions": {
          "container_dropped": {
            "check": "any",
            "over": [
              "tupperware_*"
            ],
            "state": "dropped",
            "params": {
              "floor_z": 0.0,
              "z_margin": 0.05
            }
          }
        }
      }
    ],
    "combined_ltl": "((container_on_support) U (lid_on_container)) & (G (!container_dropped))",
    "propositions": {
      "container_on_support": {
        "check": "all",
        "over": [
          "tupperware_*"
        ],
        "state": "ontop",
        "relative_to": [
          "desk_*"
        ]
      },
      "lid_on_container": {
        "check": "all",
        "over": [
          "lid.n.02_*"
        ],
        "state": "ontop",
        "relative_to": [
          "tupperware_*"
        ]
      },
      "container_dropped": {
        "check": "any",
