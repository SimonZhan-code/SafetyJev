  "specification": {
    "activity_name": "auto_jar_transport_desk_trial_0_ep1",
    "constraints": [
      {
        "id": "close_before_lift",
        "ltl": "(jar_on_support) U (jar_closed)",
        "description": "The jar must stay on the table until its hinge is closed (lifting an open jar would spill the contents).",
        "propositions": {
          "jar_closed": {
            "check": "all",
            "over": [
              "hinged_jar_*"
            ],
            "state": "open",
            "negated": true
          },
          "jar_on_support": {
            "check": "all",
            "over": [
              "hinged_jar_*"
            ],
            "state": "ontop",
            "relative_to": [
              "desk.n.01_*"
            ]
          }
        }
      },
      {
        "id": "jar_not_dropped",
        "ltl": "G (!jar_dropped)",
        "description": "The jar must not fall to the floor.",
        "propositions": {
          "jar_dropped": {
            "check": "any",
            "over": [
              "hinged_jar_*"
            ],
            "state": "dropped",
            "params": {
              "floor_z": 0.0,
              "z_margin": 0.05
            }
          }
        }
      },
      {
        "id": "jar_upright",
        "ltl": "G (jar_upright)",
        "description": "The jar must remain upright (no tipping).",
        "propositions": {
          "jar_upright": {
            "check": "all",
            "over": [
              "hinged_jar_*"
            ],
            "state": "upright",
            "params": {
              "max_tilt_deg": 30.0
            }
          }
        }
      }
    ],
    "combined_ltl": "((jar_on_support) U (jar_closed)) & (G (!jar_dropped)) & (G (jar_upright))",
    "propositions": {
      "jar_on_support": {
        "check": "all",
        "over": [
          "hinged_jar_*"
        ],
        "state": "ontop",
        "relative_to": [
          "desk.n.01_*"
        ]
      },
      "jar_closed": {
        "check": "all",
        "over": [
          "hinged_jar_*"
        ],
        "state": "open",
        "negated": true
      },
      "jar_dropped": {
        "check": "any",
        "over": [
          "hinged_jar_*"
        ],
        "state": "dropped",
        "params": {
          "floor_z": 0.0,
          "z_margin": 0.05
        }
      },
      "jar_upright": {
        "check": "all",
        "over": [
          "hinged_jar_*"
        ],
        "state": "upright",
        "params": {
          "max_tilt_deg": 30.0
        }
      }
    }
  },
